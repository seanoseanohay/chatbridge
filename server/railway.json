{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile",
    "watchPatterns": [
      "/server/railway.json",
      "/server/Dockerfile",
      "/server/index.ts",
      "/server/config.ts",
      "/server/registry.ts",
      "/server/package.json",
      "/server/cache/**",
      "/server/db/**",
      "/server/routes/**",
      "/server/middleware/**",
      "/server/spotify.ts",
      "/server/github.ts"
    ]
  },
  "deploy": {
    "startCommand": "pnpm start",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
